# Copy to .env.local and fill in.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Postgres. Use the IPv4 pooler host, not db.<ref>.supabase.co, which is IPv6-only.
# Transaction pooler (port 6543) for the app.
DATABASE_URL=
# Session pooler (port 5432) for local drizzle-kit generate/migrate.
MIGRATION_DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Also paste these into Supabase → Authentication → Providers → Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini Developer API. Used for profile extraction and opportunity intelligence.
GEMINI_API_KEY=
